#include <vector>
#include <string>

using namespace std;

class Solution
{
    public:
        string convert(const string& s, int numRows)
        {
            string converted_string = "";
            converted_string.reserve(s.size());

            int s_size = s.size();

            if(numRows == 1 || numRows >= s_size)
            {
                converted_string = s;
            }
            else
            {
                vector<string> zig_zag_vector = {};

                for(int i = 0; i < numRows; ++i)
                {
                    zig_zag_vector.push_back("");
                }

                int direction = 1;
                int row = 0;

                for(int i = 0; i < s.size(); ++i)
                {
                    zig_zag_vector.at(row) += s.at(i);

                    if(row == 0)
                    {
                        direction = 1;
                    }
                    else
                    {
                        if(row == numRows - 1)
                        {
                            direction = -1;
                        }
                    }

                    row  += direction;
                }

                for(int i = 0; i < numRows; ++i)
                {
                    converted_string += zig_zag_vector.at(i);
                }
            }

            return converted_string;
        }
};
