#include <string>

using namespace std;

class Solution
{
    public:
        string longestPalindrome(string s)
        {
            string longest_palindrome_string = "";

            int longest_laindrome_left = 0;
            int longest_palindrome_size = 0;

            int s_size = s.size();

            int centre_left = 0;
            int centre_right = 0;

            while(centre_right <= s_size)
            {
                int left = centre_left;
                int right = centre_right;

                while(left >= 0 && right < s_size)
                {
                    if(s.at(left) == s.at(right))
                    {
                        int current_longest_palindrome_string_size = (right - left) + 1;
                        
                        if(current_longest_palindrome_string_size > longest_palindrome_size)
                        {
                            longest_laindrome_left = left;
                            longest_palindrome_size = current_longest_palindrome_string_size;
                        }

                        --left;
                        ++right;
                    }
                    else
                    {
                        break;
                    }
                }

                if(centre_left == centre_right)
                {
                    ++centre_right;
                }
                else
                {
                    ++centre_left;
                }
            }

            longest_palindrome_string = s.substr(longest_laindrome_left, longest_palindrome_size);

            return longest_palindrome_string;
        }
};
