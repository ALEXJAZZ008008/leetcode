#include <string>

using namespace std;

class Solution
{
    public:
        string longestPalindrome(string s)
        {
            string longest_palindrome_string = "";
            int longest_palindrome_string_size = 0;

            int s_size = s.size();

            int centre_left = 0;
            int centre_right = 0;

            while(centre_right <= s_size)
            {
                int search_size_increment = 0;

                int left = centre_left - search_size_increment;
                int right = centre_right + search_size_increment;

                while(left >= 0 && right < s_size)
                {
                    if(s.at(left) == s.at(right))
                    {
                        int current_longest_palindrome_string_size = (right - left) + 1;
                        string current_longest_palindrome_string = s.substr(left, current_longest_palindrome_string_size);

                        if(current_longest_palindrome_string_size > longest_palindrome_string_size)
                        {
                            longest_palindrome_string = current_longest_palindrome_string;
                            longest_palindrome_string_size = current_longest_palindrome_string_size;
                        }

                        ++search_size_increment;

                        left = centre_left - search_size_increment;
                        right = centre_right + search_size_increment;
                    }
                    else
                    {
                        break;
                    }
                }

                if(centre_left == centre_right)
                {
                    ++centre_right;
                }
                else
                {
                    ++centre_left;
                }
            }

            return longest_palindrome_string;
        }
};
